{
  "$schema": "snow_weekly.schema.json",
  "_instructions": {
    "_title": "HOW TO UPDATE THIS DASHBOARD EACH WEEK",
    "_rule": "Edit ONLY this file. Never touch snow_dashboard.html.",
    "steps": [
      "1. Export Incidents, Service Requests, Problems and Changes from ServiceNow as CSV/Excel.",
      "2. Update 'meta' — change week_label, week_range, data_as_of, source_file.",
      "3. Update 'kpis' — set value, bar_pct, delta_val, delta_dir for each KPI tile.",
      "4. Update 'snow_links' — update stats[] values and button.url for each card.",
      "5. Update 'charts' — replace all data arrays with this week's numbers.",
      "6. Update 'wow_scorecard' — append new week column, drop oldest if > 8 weeks.",
      "7. Update 'intervention' — replace items[] with this week's escalation items (can be empty []).",
      "8. Update 'commentary' — rewrite each column's items[] with this week's narrative.",
      "9. Save the file as snow_weekly.json. Run Launcher.bat and choose option 1 or 2."
    ],
    "_colour_keys": "Allowed color_key values: red | amber | green | blue | purple | muted",
    "_delta_dir": "delta_dir values: 'up' | 'down' | 'flat'  (for KPIs: up=red/bad except SLA where up=green/good)",
    "_rag_values": "rag values: 'red' | 'amber' | 'green'"
  },
  "_schema_version": "1.0.0",
  "sections_comment": "Controls every section header label, icon, badge and which section is open on load.",
