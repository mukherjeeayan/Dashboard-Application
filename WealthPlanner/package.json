{
  "name": "wealthpath",
  "version": "0.1.0",
  "description": "WealthPath - jurisdiction-agnostic personal retirement & wealth planning (local-first).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bin": {
    "wealthpath": "./packages/cli/dist/index.js"
  },
  "files": [
    "packages/cli/dist",
    "packages/cli/packs",
    "packages/server/dist",
    "packages/server/packs",
    "packages/engine/dist",
    "packages/jurisdictions/dist",
    "packages/jurisdictions/packs",
    "packages/client/dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @wealthpath/engine && npm run build -w @wealthpath/jurisdictions && npm run build -w @wealthpath/server && npm run build -w @wealthpath/cli && npm run build -w @wealthpath/client",
    "prepublishOnly": "npm run build",
    "dev": "npm run dev --workspace @wealthpath/server",
    "typecheck": "tsc -b",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "jurisdiction:validate": "npm run validate --workspace @wealthpath/jurisdictions --",
    "jurisdiction:golden-test": "npm run golden-test --workspace @wealthpath/jurisdictions --"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.36.4",
    "env-paths": "^3.0.0",
    "fastify": "^4.28.1",
    "get-port": "^5.1.1",
    "open": "^8.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
